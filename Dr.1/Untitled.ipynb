import os
from sklearn.model_selection import train_test_split

# مسار البيانات
DATA_DIR = "dataset"

# الفئات
classes = ["cats", "dogs"]

for cls in classes:
    folder = os.path.join(DATA_DIR, cls)

    # جلب ملفات الصور فقط
    images = [
        f for f in os.listdir(folder)
        if f.lower().endswith((".jpg", ".jpeg", ".png", ".bmp", ".webp"))
    ]

    print(f"{cls}: {len(images)} صورة")

    # تقسيم 80% تدريب، 10% تحقق، 10% اختبار
    train, temp = train_test_split(
        images,
        test_size=0.20,
        random_state=42
    )

    val, test = train_test_split(
        temp,
        test_size=0.50,
        random_state=42
    )

    print(f"  Train      : {len(train)}")
    print(f"  Validation : {len(val)}")
    print(f"  Test       : {len(test)}")
    print()



import os
from PIL import Image
import hashlib
from collections import defaultdict

DATA_DIR = "dataset"

valid_extensions = (".jpg", ".jpeg", ".png", ".bmp", ".webp")

hashes = defaultdict(list)
bad_images = []

total = 0

for class_name in ["cats", "dogs"]:
    folder = os.path.join(DATA_DIR, class_name)

    for filename in os.listdir(folder):
        if not filename.lower().endswith(valid_extensions):
            continue

        path = os.path.join(folder, filename)
        total += 1

        # فحص أن الصورة سليمة
        try:
            with Image.open(path) as img:
                img.verify()
        except Exception:
            bad_images.append(path)
            continue

        # حساب بصمة الصورة
        with open(path, "rb") as f:
            file_hash = hashlib.md5(f.read()).hexdigest()

        hashes[file_hash].append(path)

print("إجمالي الصور:", total)
print("الصور التالفة:", len(bad_images))

duplicates = {
    h: files for h, files in hashes.items()
    if len(files) > 1
}

duplicate_count = sum(len(files) - 1 for files in duplicates.values())

print("مجموعات الصور المكررة:", len(duplicates))
print("عدد النسخ المكررة:", duplicate_count)

if bad_images:
    print("\nالصور التالفة:")
    for x in bad_images:
        print(x)

if duplicates:
    print("\nأمثلة على التكرار:")
    for h, files in list(duplicates.items())[:10]:
        print("\n---")
        for f in files:
            print(f)



import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers

# إعدادات
IMG_SIZE = (224, 224)
BATCH_SIZE = 32
EPOCHS = 20

TRAIN_DIR = "dataset_split/train"
VAL_DIR = "dataset_split/validation"
TEST_DIR = "dataset_split/test"

# تحميل البيانات
train_data = tf.keras.utils.image_dataset_from_directory(
    TRAIN_DIR,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    label_mode="binary",
    shuffle=True,
    seed=42
)

val_data = tf.keras.utils.image_dataset_from_directory(
    VAL_DIR,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    label_mode="binary",
    shuffle=False
)

test_data = tf.keras.utils.image_dataset_from_directory(
    TEST_DIR,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    label_mode="binary",
    shuffle=False
)

print("Classes:", train_data.class_names)



